                    "id": "executor-1",
                    "category": "EXECUTOR",
                    "type": "script",
                    "language": "nexa",
                    "enabled": true,
                    "config": {
                        "script": "val raw = msg.payload.rawData; msg.payload.processorId = 1; msg.payload.processedData = raw.toUpperCase(); send(msg);"
