        {
            "id": "mqtt-pool-pabrik",
            "type": "mqtt-client-pool",
            "enabled": true,
            "config": {
                "name": "koneksi mqtt 1",
                "brokerUrl": "tcp://broker.hivemq.com:1883",
                "keepAlive": 60,
                "clientId": "nexa-production-01",
                "username": "",
                "password": "",
                "cleanSession": true,
                "connectionTimeout": 30,
                "automaticReconnect": true,
                "publish": {
                    "queue": {
                        "enabled": true,
                        "capacity": 50000,
                        "overflowStrategy": "BLOCK"
                    },
                    "worker": {
                        "threads": 5,
                        "maxInflight": 5000
                    }
                }
            }
        },
        {
            "id": "mqtt-pool-pabrik-2",
