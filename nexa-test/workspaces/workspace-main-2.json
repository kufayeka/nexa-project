{
    "id": "workspace-modbus-to-mqtt",
    "enabled": true,
    "resources": [
        {
            "id": "modbus-pool-local",
            "type": "modbus-connection-pool",
            "enabled": true,
            "config": {
                "name": "koneksi modbus local",
                "host": "localhost",
                "port": 502,
                "timeout": 3000,
                "interTransactionDelay": 20,
                "writePriorityMode": "HIGH",
                "reconnectDelay": 5000,
                "keepAlive": true,
                "sortReadQueue": true
            }
        },
        {
            "id": "mqtt-pool-hivemq",
            "type": "mqtt-client-pool",
            "enabled": true,
            "config": {
                "name": "koneksi mqtt hivemq",
                "brokerUrl": "tcp://localhost:1883",
                "keepAlive": 60,
                "clientId": "nexa-modbus-mqtt-bridge",
                "username": "",
                "password": "",
                "cleanSession": true,
                "connectionTimeout": 30,
                "automaticReconnect": true,
                "publish": {
                    "queue": {
                        "enabled": true,
                        "capacity": 10000,
                        "overflowStrategy": "BLOCK"
                    },
                    "worker": {
                        "threads": 5
                    }
                }
            }
        }
    ],
    "flows": [
        {
            "id": "modbus-mqtt-flow",
            "name": "Modbus to MQTT Bridge",
            "enabled": true,
            "nodes": [
                {
                    "id": "modbus-in-1",
                    "category": "INPUT",
                    "type": "modbus-shared-input",
                    "enabled": true,
                    "config": {
                        "connectionPool": "koneksi modbus local",
                        "unitId": 1,
                        "readType": "HOLDING_REGISTERS",
                        "address": 0,
                        "quantity": 2,
                        "pollInterval": "200ms",
                        "dataType": "INT16",
                        "endianness": "ABCD",
                        "coalesce": true,
                        "outputField": "payload.value",
                        "timeout": 3000
                    }
                },
                {
                    "id": "mqtt-out-1",
                    "category": "OUTPUT",
                    "type": "mqtt-shared-sink",
                    "enabled": true,
                    "config": {
                        "mqttClientPool": "koneksi mqtt hivemq",
                        "topic": "nexa/modbus/1"
                    }
                },
                {
