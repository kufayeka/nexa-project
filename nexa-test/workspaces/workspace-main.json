{
    "id": "workspace-mqtt-loopback-stress",
    "enabled": true,
    "resources": [
        {
            "id": "mqtt-pool-loopback",
            "type": "mqtt-client-pool",
            "enabled": true,
            "config": {
                "name": "mqtt loopback stress",
                "brokerUrl": "tcp://broker.hivemq.com:1883",
                "keepAlive": 60,
                "clientId": "nexa-stress-test-loopback",
                "username": "",
                "password": "",
                "cleanSession": true,
                "connectionTimeout": 30,
                "automaticReconnect": true,
                "publish": {
                    "queue": {
                        "enabled": true,
                        "capacity": 10000,
                        "overflowStrategy": "BLOCK"
                    },
                    "worker": {
                        "threads": 5
                    }
                }
            }
        }
    ],
    "flows": [
        {
            "id": "mqtt-loopback-flow",
            "name": "MQTT Loopback Stress Test",
            "enabled": true,
            "nodes": [
                {
                    "id": "trigger-1",
                    "category": "INPUT",
                    "type": "timed-trigger",
                    "enabled": true,
                    "config": {
                        "interval": "5ms",
                        "payload": {
                            "source": "nexa-stress-test"
                        }
                    }
                },
                {
                    "id": "mqtt-out-generator",
                    "category": "OUTPUT",
                    "type": "mqtt-shared-sink",
                    "enabled": true,
                    "config": {
                        "mqttClientPool": "mqtt loopback stress",
                        "topic": "nexa/stress/loopback/input"
                    }
                },
                {
                    "id": "mqtt-in-loopback",
                    "category": "INPUT",
                    "type": "mqtt-shared-input",
                    "enabled": true,
                    "config": {
                        "mqttClientPool": "mqtt loopback stress",
                        "topic": "nexa/stress/loopback/input"
                    }
                },
                {
                    "id": "executor-process",
                    "category": "EXECUTOR",
                    "type": "script",
                    "language": "nexa",
                    "enabled": true,
                    "config": {
                        "script": "msg.payload.processed = true; send(msg);"
                    }
                },
                {
                    "id": "mqtt-out-result",
                    "category": "OUTPUT",
                    "type": "mqtt-shared-sink",
                    "enabled": true,
                    "config": {
                        "mqttClientPool": "mqtt loopback stress",
                        "topic": "nexa/stress/loopback/result"
                    }
                }
            ],
            "connections": [
                {
                    "id": "trigger-to-mqtt",
                    "enabled": true,
                    "sourceNodeId": "trigger-1",
                    "sourcePort": "default",
                    "targetNodeId": "mqtt-out-generator"
                },
                {
                    "id": "mqtt-to-input",
                    "enabled": true,
                    "sourceNodeId": "mqtt-in-loopback",
                    "sourcePort": "default",
                    "targetNodeId": "executor-process"
                },
                {
                    "id": "executor-to-result",
                    "enabled": true,
                    "sourceNodeId": "executor-process",
                    "sourcePort": "default",
                    "targetNodeId": "mqtt-out-result"
                }
            ]
        }
    ]
}